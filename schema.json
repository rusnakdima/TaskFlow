{
  "app": {
    "name": "TaskFlow",
    "id": "com.tcs.taskflow"
  },
  "entities": [
    {
      "name": "Task",
      "fields": [
        { "name": "id", "type": "string", "required": false, "default": null },
        { "name": "project_id", "type": "relation", "required": true, "default": null, "allowed": ["Project"] },
        { "name": "user_id", "type": "relation", "required": true, "default": null, "allowed": ["User"] },
        { "name": "title", "type": "string", "required": true, "default": null },
        { "name": "description", "type": "string", "required": false, "default": "" },
        { "name": "status", "type": "string", "required": true, "default": "pending", "allowed": ["pending", "completed", "skipped", "failed"] },
        { "name": "priority", "type": "string", "required": true, "default": "medium", "allowed": ["low", "medium", "high", "urgent"] },
        { "name": "start_date", "type": "string", "required": false, "default": null },
        { "name": "end_date", "type": "string", "required": false, "default": null },
        { "name": "order", "type": "int", "required": false, "default": 0 },
        { "name": "subtasks_count", "type": "int", "required": false, "default": 0 },
        { "name": "completed_subtasks_count", "type": "int", "required": false, "default": 0 },
        { "name": "comments_count", "type": "int", "required": false, "default": 0 },
        { "name": "created_at", "type": "date", "required": false, "default": null },
        { "name": "updated_at", "type": "date", "required": false, "default": null },
        { "name": "deleted_at", "type": "date", "required": false, "default": null }
      ]
    },
    {
      "name": "Project",
      "fields": [
        { "name": "id", "type": "string", "required": false, "default": null },
        { "name": "user_id", "type": "relation", "required": true, "default": null, "allowed": ["User"] },
        { "name": "title", "type": "string", "required": true, "default": null },
        { "name": "description", "type": "string", "required": false, "default": null },
        { "name": "start_date", "type": "string", "required": false, "default": null },
        { "name": "end_date", "type": "string", "required": false, "default": null },
        { "name": "categories", "type": "array", "required": false, "default": [] },
        { "name": "assignees", "type": "array", "required": false, "default": [] },
        { "name": "assignee_roles", "type": "json", "required": false, "default": {} },
        { "name": "visibility", "type": "string", "required": true, "default": "private", "allowed": ["private", "public", "shared"] },
        { "name": "priority", "type": "string", "required": true, "default": "medium", "allowed": ["low", "medium", "high", "urgent"] },
        { "name": "order", "type": "int", "required": false, "default": 0 },
        { "name": "github_repo_id", "type": "string", "required": false, "default": null },
        { "name": "github_repo_name", "type": "string", "required": false, "default": null },
        { "name": "tasks_count", "type": "int", "required": false, "default": 0 },
        { "name": "completed_tasks_count", "type": "int", "required": false, "default": 0 },
        { "name": "created_at", "type": "date", "required": false, "default": null },
        { "name": "updated_at", "type": "date", "required": false, "default": null },
        { "name": "deleted_at", "type": "date", "required": false, "default": null }
      ]
    },
    {
      "name": "Category",
      "fields": [
        { "name": "id", "type": "string", "required": false, "default": null },
        { "name": "title", "type": "string", "required": true, "default": null },
        { "name": "user_id", "type": "relation", "required": true, "default": null, "allowed": ["User"] },
        { "name": "visibility", "type": "string", "required": false, "default": "private", "allowed": ["private", "public", "shared"] },
        { "name": "created_at", "type": "date", "required": false, "default": null },
        { "name": "updated_at", "type": "date", "required": false, "default": null },
        { "name": "deleted_at", "type": "date", "required": false, "default": null }
      ]
    },
    {
      "name": "Command",
      "fields": [
        { "name": "id", "type": "string", "required": false, "default": null },
        { "name": "name", "type": "string", "required": true, "default": null },
        { "name": "kind", "type": "string", "required": true, "default": "create", "allowed": ["create", "read", "update", "delete", "list", "execute", "import", "export", "sync"] },
        { "name": "entity", "type": "string", "required": false, "default": null },
        { "name": "description", "type": "string", "required": false, "default": null },
        { "name": "blueprint", "type": "json", "required": false, "default": null },
        { "name": "auth_required", "type": "bool", "required": false, "default": true },
        { "name": "created_at", "type": "date", "required": false, "default": null }
      ]
    },
    {
      "name": "Role",
      "fields": [
        { "name": "id", "type": "string", "required": false, "default": null },
        { "name": "name", "type": "string", "required": true, "default": null, "allowed": ["viewer", "editor", "moderator", "owner", "admin"] },
        { "name": "permissions", "type": "array", "required": false, "default": [] },
        { "name": "description", "type": "string", "required": false, "default": null },
        { "name": "assignee_default", "type": "bool", "required": false, "default": false }
      ]
    },
    {
      "name": "User",
      "fields": [
        { "name": "id", "type": "string", "required": false, "default": null },
        { "name": "email", "type": "string", "required": true, "default": null },
        { "name": "username", "type": "string", "required": true, "default": null },
        { "name": "password", "type": "string", "required": true, "default": null },
        { "name": "role", "type": "string", "required": true, "default": "viewer", "allowed": ["viewer", "editor", "moderator", "owner", "admin"] },
        { "name": "profile_id", "type": "string", "required": false, "default": null },
        { "name": "totp_enabled", "type": "bool", "required": false, "default": false },
        { "name": "totp_secret", "type": "string", "required": false, "default": "" },
        { "name": "qr_login_enabled", "type": "bool", "required": false, "default": false },
        { "name": "github_access_token", "type": "string", "required": false, "default": "" },
        { "name": "github_refresh_token", "type": "string", "required": false, "default": "" },
        { "name": "github_token_expiry", "type": "string", "required": false, "default": "" },
        { "name": "github_user_id", "type": "string", "required": false, "default": "" },
        { "name": "github_username", "type": "string", "required": false, "default": "" },
        { "name": "recovery_codes", "type": "array", "required": false, "default": [] },
        { "name": "created_at", "type": "date", "required": false, "default": null },
        { "name": "updated_at", "type": "date", "required": false, "default": null },
        { "name": "deleted_at", "type": "date", "required": false, "default": null }
      ]
    }
  ],
  "pages": [
    {
      "route": "/login",
      "title": "Login",
      "components": [
        { "type": "text", "content": "Sign in to TaskFlow" },
        { "type": "input", "name": "username", "label": "Username", "required": true },
        { "type": "input", "name": "password", "label": "Password", "required": true, "props": { "type": "password" } },
        { "type": "button", "label": "Sign In", "action": "auth.login" },
        { "type": "button", "label": "Sign Up", "action": "navigate.signup" },
        { "type": "button", "label": "Reset Password", "action": "navigate.reset_password" }
      ]
    },
    {
      "route": "/signup",
      "title": "Sign Up",
      "components": [
        { "type": "text", "content": "Create your TaskFlow account" },
        { "type": "input", "name": "email", "label": "Email", "required": true },
        { "type": "input", "name": "username", "label": "Username", "required": true },
        { "type": "input", "name": "password", "label": "Password", "required": true, "props": { "type": "password" } },
        { "type": "button", "label": "Create Account", "action": "auth.register" }
      ]
    },
    {
      "route": "/tasks",
      "title": "Tasks",
      "components": [
        { "type": "text", "content": "Tasks" },
        { "type": "list", "entity": "Task", "filter": { "field": "user_id", "value": "$current_user.id" } },
        { "type": "button", "label": "New Task", "action": "task.create" },
        { "type": "table", "entity": "Task", "columns": ["title", "status", "priority", "start_date", "end_date"] }
      ]
    },
    {
      "route": "/projects",
      "title": "Projects",
      "components": [
        { "type": "text", "content": "Projects" },
        { "type": "list", "entity": "Project", "filter": { "field": "user_id", "value": "$current_user.id" } },
        { "type": "button", "label": "New Project", "action": "project.create" },
        { "type": "table", "entity": "Project", "columns": ["title", "visibility", "priority", "tasks_count", "completed_tasks_count"] }
      ]
    },
    {
      "route": "/calendar",
      "title": "Calendar",
      "components": [
        { "type": "text", "content": "Calendar" },
        { "type": "card", "title": "Schedule", "entity": "Task", "view": "calendar" },
        { "type": "button", "label": "Today", "action": "calendar.today" },
        { "type": "button", "label": "Month View", "action": "calendar.view_month" }
      ]
    },
    {
      "route": "/stats",
      "title": "Statistics",
      "components": [
        { "type": "text", "content": "Statistics" },
        { "type": "card", "title": "Completion Trend", "entity": "Task", "view": "trend" },
        { "type": "card", "title": "Daily Activity", "entity": "Task", "view": "daily_activity" },
        { "type": "card", "title": "Detailed Metrics", "entity": "Project", "view": "metrics" }
      ]
    },
    {
      "route": "/chat",
      "title": "Chat",
      "components": [
        { "type": "text", "content": "Chat" },
        { "type": "list", "entity": "Chat", "filter": { "field": "room_id", "value": "$current_room.id" } },
        { "type": "input", "name": "message", "label": "Message" },
        { "type": "button", "label": "Send", "action": "chat.send_message" }
      ]
    },
    {
      "route": "/categories",
      "title": "Categories",
      "components": [
        { "type": "text", "content": "Categories" },
        { "type": "list", "entity": "Category", "filter": { "field": "user_id", "value": "$current_user.id" } },
        { "type": "form", "entity": "Category", "fields": ["title", "visibility"] },
        { "type": "button", "label": "Save", "action": "category.upsert" }
      ]
    },
    {
      "route": "/sync",
      "title": "Data Synchronization",
      "components": [
        { "type": "text", "content": "Sync your data across devices" },
        { "type": "button", "label": "Export to Cloud", "action": "sync.export" },
        { "type": "button", "label": "Import to Local", "action": "sync.import" },
        { "type": "button", "label": "Initialize User Data", "action": "sync.initialize_user_data" },
        { "type": "button", "label": "Check Connection", "action": "sync.check_mongodb_connection" }
      ]
    },
    {
      "route": "/archive",
      "title": "Archive",
      "components": [
        { "type": "text", "content": "Archive" },
        { "type": "table", "entity": "Task", "filter": { "field": "deleted_at", "op": "not_null" } },
        { "type": "button", "label": "Restore", "action": "archive.restore" },
        { "type": "button", "label": "Delete Permanently", "action": "archive.hard_delete" }
      ]
    },
    {
      "route": "/admin",
      "title": "Admin",
      "components": [
        { "type": "text", "content": "Admin Data Management" },
        { "type": "table", "entity": "Task", "columns": ["title", "status", "user_id", "created_at"] },
        { "type": "button", "label": "Soft Delete", "action": "admin.soft_remove" },
        { "type": "button", "label": "Hard Delete", "action": "admin.hard_remove" },
        { "type": "button", "label": "Cleanup Non-Private", "action": "admin.cleanup_non_private" }
      ]
    }
  ],
  "actions": [
    { "name": "auth.login", "blueprint": { "command": "login", "fields": ["username", "password"] } },
    { "name": "auth.register", "blueprint": { "command": "register", "fields": ["email", "username", "password"] } },
    { "name": "auth.check_token", "blueprint": { "command": "check_token", "fields": ["token"] } },
    { "name": "auth.setup_totp", "blueprint": { "command": "setup_totp", "fields": ["username"] } },
    { "name": "auth.enable_totp", "blueprint": { "command": "enable_totp", "fields": ["username", "code"] } },
    { "name": "auth.disable_totp", "blueprint": { "command": "disable_totp", "fields": ["username", "code"] } },
    { "name": "auth.verify_login_totp", "blueprint": { "command": "verify_login_totp", "fields": ["username", "code"] } },
    { "name": "auth.use_recovery_code", "blueprint": { "command": "use_recovery_code", "fields": ["username", "code"] } },
    { "name": "auth.request_password_reset", "blueprint": { "command": "request_password_reset", "fields": ["email"] } },
    { "name": "auth.verify_code", "blueprint": { "command": "verify_code", "fields": ["email", "code"] } },
    { "name": "auth.reset_password", "blueprint": { "command": "reset_password", "fields": ["token", "new_password"] } },
    { "name": "auth.change_password", "blueprint": { "command": "change_password", "fields": ["token", "new_password"] } },
    { "name": "auth.qr_generate", "blueprint": { "command": "qr_generate" } },
    { "name": "auth.qr_status", "blueprint": { "command": "qr_status", "fields": ["token"] } },
    { "name": "auth.qr_login_complete", "blueprint": { "command": "qr_login_complete", "fields": ["token"] } },
    { "name": "navigate.signup", "blueprint": { "kind": "navigate", "route": "/signup" } },
    { "name": "navigate.reset_password", "blueprint": { "kind": "navigate", "route": "/reset-password" } },
    { "name": "task.create", "blueprint": { "command": "task_create", "entity": "Task" } },
    { "name": "task.update", "blueprint": { "command": "task_update", "entity": "Task" } },
    { "name": "task.delete", "blueprint": { "command": "task_delete", "entity": "Task" } },
    { "name": "task.list", "blueprint": { "command": "task_list", "entity": "Task" } },
    { "name": "project.create", "blueprint": { "command": "project_create", "entity": "Project" } },
    { "name": "project.update", "blueprint": { "command": "project_update", "entity": "Project" } },
    { "name": "project.delete", "blueprint": { "command": "project_delete", "entity": "Project" } },
    { "name": "project.list", "blueprint": { "command": "project_list", "entity": "Project" } },
    { "name": "project.change_visibility", "blueprint": { "command": "change_todo_visibility" } },
    { "name": "project.update_permissions", "blueprint": { "command": "update_todo_permissions" } },
    { "name": "project.transfer_ownership", "blueprint": { "command": "transfer_todo_ownership" } },
    { "name": "project.get_permissions", "blueprint": { "command": "get_todo_permissions" } },
    { "name": "category.upsert", "blueprint": { "command": "category_upsert", "entity": "Category" } },
    { "name": "category.list", "blueprint": { "command": "category_list", "entity": "Category" } },
    { "name": "category.delete", "blueprint": { "command": "category_delete", "entity": "Category" } },
    { "name": "subtask.create", "blueprint": { "command": "subtask_create", "entity": "Subtask" } },
    { "name": "subtask.update", "blueprint": { "command": "subtask_update", "entity": "Subtask" } },
    { "name": "subtask.delete", "blueprint": { "command": "subtask_delete", "entity": "Subtask" } },
    { "name": "subtask.list", "blueprint": { "command": "subtask_list", "entity": "Subtask" } },
    { "name": "chat.send_message", "blueprint": { "command": "send_message", "entity": "Chat" } },
    { "name": "chat.get_messages", "blueprint": { "command": "get_messages_by_room" } },
    { "name": "chat.edit_message", "blueprint": { "command": "edit_message" } },
    { "name": "chat.delete_message", "blueprint": { "command": "delete_message" } },
    { "name": "chat.add_reaction", "blueprint": { "command": "add_message_reaction" } },
    { "name": "chat.remove_reaction", "blueprint": { "command": "remove_message_reaction" } },
    { "name": "chat.mark_read", "blueprint": { "command": "mark_message_read" } },
    { "name": "group.add_members", "blueprint": { "command": "add_group_members" } },
    { "name": "group.remove_members", "blueprint": { "command": "remove_group_members" } },
    { "name": "group.delete", "blueprint": { "command": "delete_group_cascade" } },
    { "name": "group.get_by_room", "blueprint": { "command": "get_group_by_room" } },
    { "name": "stats.get", "blueprint": { "command": "statistics_get" } },
    { "name": "stats.tasks_by_month", "blueprint": { "command": "get_tasks_by_month" } },
    { "name": "calendar.today", "blueprint": { "kind": "navigate", "route": "/calendar" } },
    { "name": "calendar.view_month", "blueprint": { "kind": "navigate", "route": "/calendar", "view": "month" } },
    { "name": "sync.export", "blueprint": { "command": "export_to_cloud" } },
    { "name": "sync.import", "blueprint": { "command": "import_to_local" } },
    { "name": "sync.initialize_user_data", "blueprint": { "command": "initialize_user_data" } },
    { "name": "sync.check_mongodb_connection", "blueprint": { "command": "check_mongodb_connection" } },
    { "name": "archive.list", "blueprint": { "command": "get_all_archive_data" } },
    { "name": "archive.paginated", "blueprint": { "command": "get_all_archive_paginated" } },
    { "name": "archive.soft_delete", "blueprint": { "command": "soft_delete" } },
    { "name": "archive.hard_delete", "blueprint": { "command": "permanent_delete" } },
    { "name": "admin.list", "blueprint": { "command": "get_all_admin_data" } },
    { "name": "admin.paginated", "blueprint": { "command": "get_all_admin_paginated" } },
    { "name": "admin.soft_remove", "blueprint": { "command": "soft_remove_data" } },
    { "name": "admin.hard_remove", "blueprint": { "command": "hard_remove_data" } },
    { "name": "admin.batch_soft_delete", "blueprint": { "command": "batch_soft_delete_cascade" } },
    { "name": "admin.batch_hard_delete", "blueprint": { "command": "batch_hard_delete_cascade" } },
    { "name": "admin.batch_restore", "blueprint": { "command": "batch_restore_cascade" } },
    { "name": "admin.cleanup_non_private", "blueprint": { "command": "cleanup_non_private_from_json" } },
    { "name": "admin.get_tasks_by_month", "blueprint": { "command": "get_tasks_by_month" } },
    { "name": "crud.execute", "blueprint": { "command": "crud_execute" } },
    { "name": "schema.get", "blueprint": { "command": "get_schema" } },
    { "name": "github.oauth_url", "blueprint": { "command": "github_oauth_url" } },
    { "name": "github.oauth_callback", "blueprint": { "command": "github_oauth_callback" } },
    { "name": "github.start_device_flow", "blueprint": { "command": "github_start_device_flow" } },
    { "name": "github.check_device_flow", "blueprint": { "command": "github_check_device_flow" } },
    { "name": "github.get_repos", "blueprint": { "command": "github_get_repos" } },
    { "name": "github.connection_status", "blueprint": { "command": "github_get_connection_status" } },
    { "name": "github.disconnect", "blueprint": { "command": "github_disconnect" } },
    { "name": "github.create_issue", "blueprint": { "command": "github_create_issue" } },
    { "name": "github.update_issue", "blueprint": { "command": "github_update_issue" } },
    { "name": "github.create_comment", "blueprint": { "command": "github_create_comment" } },
    { "name": "update.binary_name", "blueprint": { "command": "getBinaryNameFile" } },
    { "name": "update.download", "blueprint": { "command": "downloadUpdate" } },
    { "name": "update.install", "blueprint": { "command": "installUpdate" } },
    { "name": "update.open_file", "blueprint": { "command": "openFile" } },
    { "name": "noop", "blueprint": null }
  ]
}