@startuml logic-auth-session
title TaskFlow MASTER — Auth / Session lifecycle\n(sources: src-tauri/src/services/auth*.service.rs, commands/auth.command.rs,\nutils/auth.helper.rs, utils/security.helper.rs, utils/qr.helper.rs)

|#lightblue|Register (auth-register.service.rs)|
start
:SignupForm {email, username, password};
:$or filter: email OR username exists?;
if (exists in JSON?) then (yes)
  #FFCCCC:err "User already exists";
  stop
elseif (Mongo online AND user exists there?) then (yes)
  #FFCCCC:err "User already exists in cloud";
  stop
else (free)
  :password = bcrypt::hash(password, DEFAULT_COST);
  :user_id = generate_id(); profile_id = generate_id();
  :create ProfileEntity {name: username,\nimage_url:"/assets/images/user.png", user_id}\nin JSON;
  if (Mongo available?) then (yes)
    if (ensure_profile_in_both(user_id) fails?) then (yes)
      #FFCCCC:err propagate (profile sync failure aborts);
      stop
    else (ok)
      :insert UserEntity (both providers);
    endif
  else (no)
    :insert UserEntity (JSON);
  endif
  :generate JWT token (24h default);
  :return {token, profile};
  stop
endif

|#lightblue|Login (auth-login.service.rs)|
start
:LoginForm {username, password, remember};
:find_user_by_username(JSON, Mongo?, username);
if (User found?) then (no)
  #FFCCCC:err "User not found";
  stop
else (yes)
  if (bcrypt::verify(password, user.password)?) then (no)
    #FFCCCC:err "Invalid password";
    stop
  else (valid)
    :profile = profile_sync.get_profile(user_id);
    :token = generate_token(user_id, profile_id, role, remember?\nremember -> exp 30 days, else 24 hours\nClaims {id, profile_id, role, exp});
    :auth_data_sync.on_user_login(user_id)\n(cloud pull of user/profile on login);
    :return {token, profile};
    stop
  endif
endif

|#lightblue|Token session (auth-token.service.rs)|
start
:check_token(token);
:jwt decode with jwt_secret + default validation;
if (Signature/exp valid?) then (no)
  #FFCCCC:err "Invalid token";
  stop
else (yes)
  if (Mongo online?) then (yes)
    :check user FIRST in Mongo\ndetects cloud-side deleted users;
    if (deleted upstream?) then (yes)
      #FFCCCC:treat as invalid session;
      stop
    else (alive)
      :fall back to JSON copy if needed;
      stop
    endif
  else (no)
    :verify against JSON provider only;
    stop
  endif
endif

|#lightblue|Password reset (email code)|
start
:request_password_reset(email):
  requires **Mongo online** else err "MongoDB offline";
  :code = random 6-digit; expiry = now+15min;
  :store temporary_code/code_expires_at on user\n(JSON update + optional Mongo);
  :EmailProvider.send_password_reset_code(email, code)\nsend failure -> err "Failed to send reset email";
:verify_code(email, code):
  match stored code AND now < expires_at\n(mismatch -> "Invalid verification code";\n expired -> "Code expired");
:reset_password(PasswordReset{email,new_password}):
  bcrypt hash + persist both providers;

|#lightblue|TOTP 2FA & QR cross-device auth|
start
:setup_totp/enable_totp/disable_totp/use_recovery_code/\nverify_login_totp/get_user_security_status\n(AuthTotpService: secret provisioning + code verify +\nrecovery-code burn, token service integration);
:qr_generate/qr_generate_for_desktop/qr_approve/qr_status/\nqr_toggle/qr_login_complete\n(QrAuthService: pending-login store, polling status,\nmobile approval mints desktop session token);

note right
  All four blocks above are web/mobile-oriented
  surfaces of the master Tauri backend.
endnote
@enduml
