@startuml
title TaskFlow — AS-IS Auth Sequence
skinparam componentStyle rectangle
skinparam linetype ortho

actor User
participant "Tauri Frontend" as FE
participant "auth_command" as CMD
participant "AuthService" as AUTH
participant "JwtService" as JWT
participant "JsonProvider" as JSON
participant "MongoProvider" as MONGO

User -> FE : login(email, password)
FE -> CMD : login(LoginForm)
CMD -> AUTH : login(form)

alt #LightGreen basic login
  AUTH -> JSON : find_user_by_email(email)
  JSON --> AUTH : UserEntity?
  AUTH -> AUTH : verify_password(password, hash)
  AUTH -> JWT : generate_tokens(user_id)
  JWT --> AUTH : (access_token, refresh_token)
  AUTH -> JSON : upsert_session()
  AUTH --> CMD : ResponseModel { token }
  CMD --> FE : ResponseModel { token }
  FE --> User : logged in

else #LightYellow TOTP enabled
  AUTH -> AUTH : requires_totp()
  AUTH --> CMD : ResponseModel { requires_totp: true }
  CMD --> FE : requires_totp challenge
  FE -> CMD : verify_login_totp(totp_code)
  CMD -> AUTH : verify_totp(code)
  AUTH -> MONGO : verify_totp(user_id, code)
  MONGO --> AUTH : valid
  AUTH -> JWT : generate_tokens()
  AUTH --> CMD : ResponseModel { token }
  CMD --> FE : authenticated
end

note over CMD, AUTH
  All commands accept State<AppState>
  AppState fields: config, auth, data, chat, system
end note

note over JWT
  JWT secret from ConfigHelper
  Token contains: user_id, role, exp
end note
@enduml
