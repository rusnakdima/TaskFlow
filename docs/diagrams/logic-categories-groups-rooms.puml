@startuml logic-categories-groups-rooms
title TaskFlow MASTER — Categories / Groups / Rooms lifecycle\n(sources: src-tauri/src/services/{category,group,room}.service.rs,\ncommands/group.command.rs, commands/room.command.rs)

|#lightblue|CategoryService|
start
:Category op (get/getAll/create/update/delete, user_id);
if (delete?) then (yes)
  :find category (scoped by user_id);
  if (Found + owned?) then (no)
    #FFCCCC:err not found / unauthorized;
    stop
  else (yes)
    :soft delete via cascade helper\n(categories = single-node soft delete);
    note right
      Todos keep dangling category id/name
      references — master does NOT rewrite
      todo.categories on category delete.
    endnote
    stop
  endif
else (crud)
  :plain provider CRUD on "categories"\n(visibility routes Json vs Mongo like todos);
  stop
endif

|#lightblue|RoomService|
start
:Room op;
if (create) then (yes)
  :insert "rooms" {name, room, is_group, participant_ids};
  stop
elseif (update) then (update)
  :patch "rooms" by id;
  stop
elseif (get_by_room / get_rooms) then (query)
  :find rooms (filter: room key or participant);
  stop
else (delete)
  :soft/hard delete single room doc;
  note right
    Master room delete does NOT cascade
    to chats; group deletion handles that.
  endnote
  stop
endif

partition "find_or_create_dm_room (room.service.rs)" {
  :send_message(room_id, sender_id, receiver_id, dm_name, ...);
  :is_dm = room_id.starts_with("dm_");
  if (DM room exists?) then (no)
    :create room {room: dm_<a>_<b>, is_group:false,\nparticipants:[sender, receiver]};
  else (yes)
    :reuse existing room;
  endif
}

|#lightblue|GroupService|
start
:Group op;
partition "create_group" {
  :insert "groups" {name, member_ids, room_id...};
}
partition "add/remove_group_members" {
  :load group -> mutate member_ids array -> update;\n(duplicates in add_members are tolerated/merged);
}
partition "get_group_by_room" {
  :filter groups by room_id, return first;
}
partition "ensure_rooms_for_groups (command)" {
  :getAll groups (limit 1000);
  while (more groups?) is (yes)
    if (group.room_id empty?) then (yes)
      :skip silently;
    elseif (room exists for room_id?) then (yes)
      :skipped_count += 1;
    else (no)
      :create room {name: group.name, is_group:true,\nparticipant_ids: group.member_ids};
      :created_count += 1;
    endif
  endwhile (no)
  :return {created, skipped};
}
partition "delete_group vs delete_group_cascade" {
  :delete_group:
    mongo-only lookup (dm_ prefix bypasses lookup),
    resolves (doc_id, room_id), soft deletes group;
  :delete_group_cascade (hard):
    1. find group by room_id (Mongo, fallback JSON)
       else err "Group not found";
    2. resolve actual_room_id = group.room_id ?: arg;
    3. hard-delete EVERY chat doc with room_id
       from JSON **and** Mongo providers;
    4. hard-delete group docs + room doc;
  #FFCCCC:any provider failure mid-way leaves partial state\n(no transactional rollback);
}
@enduml
