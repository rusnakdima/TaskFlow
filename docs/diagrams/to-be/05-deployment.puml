@startuml
title TaskFlow — TO-BE Deployment Architecture
skinparam componentStyle rectangle
skinparam linetype ortho
' Generated by /arch-diagrams from /home/dmitriy/Projects/TaskFlow
' DO NOT EDIT BY HAND — re-run /arch-diagrams to regenerate

node "Desktop (Tauri v2)" as TAURI {
  package "Dioxus WebView" #LightBlue {
    [pages/]
    [components/]
    [signals/]
    [hooks/]
  }

  package "Tauri Backend (Thin)" #Gray {
    [KAS Handlers\n(thin invoke wrappers)]
    [tauri_plugin_mcp_bridge]
  }
}

package "src-tauri/src/" #LightGreen {
  package "application/" {
    [TodoApplicationService]
    [AuthApplicationService]
    [ChatApplicationService]
    [SyncApplicationService]
  }

  package "domain/" {
    [entities/]
    [value_objects/]
    [services/]
  }

  package "infrastructure/" {
    [persistence/\n  JsonRepository,\n  MongoRepository]
    [sync/\n  SyncEngine]
  }
}

package "dioxus-shared" #Orange {
  [themes/]
  [ui/render_component.rs]
  [algorithms/]
  [schema/]
}

database "Local Storage" {
  [JSON Files\n~/.taskflow/*.json]
}

database "MongoDB Atlas" as MONGO {
  [users]
  [todos]
  [tasks]
  [groups]
  [rooms]
}

cloud "GitHub API" as GITHUB {
  [Issues]
  [Repos]
}

TAURI --> "dioxus-shared"
TAURI --> MONGO
TAURI --> GITHUB
TAURI --> "Local Storage"

note bottom of TAURI
  Dioxus serves UI, Tauri only handles IPC
  Business logic entirely in application/domain layers
end note

note bottom of application/
  Application services orchestrate domain logic
  Each service method = one use case
  No direct database access here
end note

note bottom of infrastructure/
  Repositories implement domain traits
  nosql_orm for persistence
end note
@enduml
