@startuml
title TaskFlow — TO-BE Auth Sequence
skinparam componentStyle rectangle
skinparam linetype ortho
' Generated by /arch-diagrams from /home/dmitriy/Projects/TaskFlow
' DO NOT EDIT BY HAND — re-run /arch-diagrams to regenerate

actor User
participant "Dioxus Frontend\n(Signals/Hooks)" as FE
participant "kas_handler::auth\n(login)" as HANDLER
participant "AuthApplicationService" as APP_AUTH
participant "AuthDomainService" as DOMAIN_AUTH
participant "UserRepository\n(Json + Mongo)" as REPO

User -> FE : login(email, password)
FE -> HANDLER : invoke(login, LoginDTO)
HANDLER -> APP_AUTH : login(dto)
APP_AUTH -> REPO : find_by_email(email)
REPO --> APP_AUTH : UserEntity?
APP_AUTH -> DOMAIN_AUTH : verify_password(password, hash)
DOMAIN_AUTH -> DOMAIN_AUTH : check_totp_required?

alt #LightGreen basic login
  DOMAIN_AUTH --> APP_AUTH : AuthTokens
  APP_AUTH --> HANDLER : Result<AuthResponse>
  HANDLER --> FE : token signal updated
  FE --> User : authenticated

else #LightYellow TOTP required
  DOMAIN_AUTH --> APP_AUTH : RequiresTotp
  APP_AUTH --> HANDLER : Result { requires_totp: true }
  HANDLER --> FE : show totp input
  User -> FE : enter totp code
  FE -> HANDLER : invoke(verify_totp, code)
  HANDLER -> APP_AUTH : verify_totp(code)
  APP_AUTH -> DOMAIN_AUTH : verify_totp(user_id, code)
  DOMAIN_AUTH -> REPO : verify_totp()
  REPO --> DOMAIN_AUTH : valid
  DOMAIN_AUTH --> APP_AUTH : tokens
  APP_AUTH --> HANDLER : Result<AuthResponse>
end

note over FE
  Dioxus signals: use_signal("auth_token")
  KAS invoke handler via tauri_plugin_mcp_bridge
end note

note over HANDLER
  #[kas_handler(invoke)]
  Thin wrapper, all logic in application/domain
end note
@enduml
