@startuml logic-statistics-activity
title TaskFlow MASTER — Statistics / Daily-Activity engine\n(sources: src-tauri/src/services/statistics*.service.rs,\nentities/daily_activity.entity.rs, utils/activity*.rs,\nutils/percentage.helper.rs, commands/stats.command.rs)

start
:statistics_get(user_id, time_range)\n(visibility hard-coded "private");
:DateCalculator::calculate_date_range(time_range);
note right
  "day"     -> today 00:00 local
  "week"    -> Monday 00:00 of current week
  "month"   -> 1st of month 00:00
  "quarter" -> quarter-start month day 1
  "year"    -> Jan 1 ordinal 1
  default   -> now - 7 days
  end_date  = now
endnote
:(start_date, end_date);
:previous window = [start - (end-start), start)\n(equal-length comparison period);

partition "Data collection" {
  :daily_activities = find_many("daily_activities",\nuser_id, date in [start,end]);
  :previous_daily_activities = same for prev window;
  :todos = find_many("todos", {user_id});
  :todo_ids = todos.id list;
  :all_tasks = find_many("tasks") (unfiltered!);
  :current_tasks = tasks where todo_id ∈ todo_ids\nAND (created_at OR updated_at) within [start_str, end_str]\n(string RFC3339 compare);
  :previous_tasks = same with [prev_start_str, end_str)\nhalf-open interval (boundary asymmetry vs current);
}

partition "CategoryStatistics::calculate_category_tasks" {
  :group tasks by todo_id;
  :filter_tasks_by_date(created_at|updated_at naive date in range);
  foreach category -> todos:
    match todo.categories entry against category via\nid == id | name == id | bare-string id;
    count tasks_in_range as task_count;
    status ∈ {"completed","skipped"} counts\nas completed_task_count;
    todo listed only if it has ≥1 relevant task;
}

partition "TaskAnalytics" {
  :compute_activity_totals(docs):\n total = Σ(tasks_created+tasks_updated+tasks_completed)\n completed = Σ(tasks_completed)   [aggregation group];
  :completion_rate = calculate_percentage(completed,total);
  :calculate_average_task_time:\n filter status ∈ {completed, skipped};\n avg hours(updated_at - created_at), truncated to i32;\n empty -> 0;
  :productivity_score:\n Σ(todos_created+updated+deleted + tasks_created+completed\n   + subtasks_created+completed) per activity doc;\n score / docs.len(), truncated to i32; empty -> 0;
  :same four metrics recomputed on previous window;
}

:StatisticsModel {
  total_tasks, completion_rate, average_task_time,
  productivity_score,
  previous_total_tasks, previous_completion_rate,
  previous_average_time, previous_productivity_score
} + detailed metrics (chart generator series);
stop

partition "Activity recording (write path)" {
  :ActivityMonitorService.log_action(table, action, data)\ncalled from CascadeService deletes and repository layer;
  :upserts one daily_activity doc per user/day with\ncounters: todos_created/updated/deleted,\ntasks_created/completed, subtasks_created/completed...;
  :EntityResolutionService reconciles identities across\nJSON/Mongo copies before counting;
}
@enduml
